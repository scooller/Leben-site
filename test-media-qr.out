                    <script>\n
                const loadDarkMode = () => {\n
                    window.theme = localStorage.getItem('theme') ?? 'system'\n
                    if (\n
                        window.theme === 'dark' ||\n
                        (window.theme === 'system' &&\n
                            window.matchMedia('(prefers-color-scheme: dark)')\n
                                .matches)\n
                    ) {\n
                        document.documentElement.classList.add('dark')\n
                    }\n
                }\n
\n
                loadDarkMode()\n
\n
                document.addEventListener('livewire:navigated', loadDarkMode)\n
            </script>\n
        \n
