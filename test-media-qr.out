            <script>\n
                var collapsedGroups = JSON.parse(\n
                    localStorage.getItem('collapsedGroups'),\n
                )\n
\n
                if (collapsedGroups === null || collapsedGroups === 'null') {\n
                    localStorage.setItem(\n
                        'collapsedGroups',\n
                        JSON.stringify([]),\n
                    )\n
                }\n
\n
                collapsedGroups = JSON.parse(\n
                    localStorage.getItem('collapsedGroups'),\n
                )\n
\n
                document\n
                    .querySelectorAll('.fi-sidebar-group')\n
                    .forEach((group) => {\n
                        if (\n
                            !collapsedGroups.includes(group.dataset.groupLabel)\n
                        ) {\n
                            return\n
                        }\n
\n
                        // Alpine.js loads too slow, so attempt to hide a\n
                        // collapsed sidebar group earlier.\n
                        group.querySelector(\n
                            '.fi-sidebar-group-items',\n
                        ).style.display = 'none'\n
                        group.classList.add('fi-collapsed')\n
                    })\n
            </script>\n
